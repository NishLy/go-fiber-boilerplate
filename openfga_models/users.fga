model
  schema 1.1

type system
  relations
    define admin: [user]

type branch
  relations
    define member: [user]

type user
  relations
    define owner: [user]       
    define branch: [branch]

    define viewer_branch: [branch#member]
    define viewer_all: [system#admin]

    define editor_all: [system#admin]
    define deleter_all: [system#admin]

    define can_view: owner or viewer_branch or viewer_all
    define can_edit: owner or editor_all
    define can_delete: owner or deleter_all